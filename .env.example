# Copy this file to .env and fill in the empty values. Never commit .env.

# Password for the PostgreSQL "postgres" user. Only applied when the database volume is first created.
POSTGRES_PASSWORD=

# Signing key for login tokens, at least 32 characters. Generate one with: openssl rand -base64 48
ARCHMAXIM_JWT_SECRET=

# Initial admin account, created on first start when no admin exists yet. Password: at least 8 characters.
ARCHMAXIM_ADMIN_EMAIL=admin@archmaxim.edu
ARCHMAXIM_ADMIN_PASSWORD=

# Host port for the web interface.
ARCHMAXIM_PORT=3000

# Set to true to serve the API docs at /api/swagger-ui.html.
ARCHMAXIM_SWAGGER_ENABLED=false
